model Payment {
  id     String        @id @default(uuid())
  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  method         PaymentMethod
  paymentGateway String? // "bkash" | "sslcommerz" | "stripe" | null for COD

  merchantInvoiceNumber String @unique // shipment tracking number

  gatewayTransactionId String? // bKash trxID / SSLCommerz val_id / Stripe payment_intent id
  gatewayReferenceId   String? // bKash paymentID / SSLCommerz sessionkey / Stripe session id
  payerReference       String? // user email / phone
  paidAt               DateTime?

  gatewayResponse Json?

  refundTransactionId String?
  refundAmount        Decimal?  @db.Decimal(10, 2)
  refundReason        String?
  refundedAt          DateTime?

  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId], name: "idx_payment_shipmentId")
  @@map("payments")
}